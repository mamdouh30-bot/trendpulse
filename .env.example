# ============================================================
#  TrendPulse — live credentials template
#  نسخ هذا الملف إلى .env وتعبئة القيم — لا ترفع .env أبداً إلى Git
# ============================================================

# ------------------- YouTube auto-upload (إلزامي للرفع التلقائي) -------------------
# من Google Cloud Console → OAuth client (نوع Desktop) + refresh token بنطاق
# youtube.upload — راجع README-DEPLOY.md القسم "بيانات YouTube"
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_API_KEY=

# ------------------- LLM (اختياري — بدون مفتاح يعمل عبر Pollinations) -------------------
# خيار 1 (موصى به): مفتاح Gemini مجاني من https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# خيار 2: OpenRouter  -> LLM_BASE_URL=https://openrouter.ai/api/v1
#                      LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# خيار 3: Groq        -> LLM_BASE_URL=https://api.groq.com/openai/v1
#                      LLM_MODEL=llama-3.3-70b-versatile
# بدون أي مفتاح: يُستخدم text.pollinations.ai مجاناً بلا تسجيل

# ------------------- البحث (اختياري — بدون مفتاح يعمل عبر DuckDuckGo) -------------------
TAVILY_API_KEY=        # tavily.com مجاني 1000 بحث/شهر — جودة أعلى من DuckDuckGo
SERPER_API_KEY=
BRAVE_API_KEY=

# ------------------- الصور (اختياري — بدون مفتاح يعمل عبر Openverse + Pollinations) -------------------
PEXELS_API_KEY=        # pexels.com/api مجاني — صور فوتوغرافية عالية الجودة
PIXABAY_API_KEY=       # pixabay.com/api مجاني

# ------------------- التعليق الصوتي (اختياري) -------------------
ELEVENLABS_API_KEY=    # بدون مفتاح يُستخدم edge-tts المجاني (Microsoft neural)
TRENDPULSE_EDGE_VOICE=en-US-ChristopherNeural

# ------------------- عام -------------------
YT_CHANNEL_HANDLE=@aimoneytested
TRENDPULSE_FAST_RENDER=1          # رندر أسرع (موصى به على الاستضافات المجانية)
TRENDPULSE_INTERVAL_SECONDS=43200 # الفاصل بين الدورات في وضع Docker = 12 ساعة
